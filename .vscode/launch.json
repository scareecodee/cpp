{
  "C_Cpp_Runner.cCompilerPath": "gcc",
  "C_Cpp_Runner.cppCompilerPath": "g++",
  "C_Cpp_Runner.debuggerPath": "gdb",
  "C_Cpp_Runner.useMsvc": false,
  "C_Cpp_Runner.warnings": [
    "-Wall",
    "-Wextra",
    "-Wpedantic",
    "-Wshadow",
    "-Wformat=2",
    "-Wcast-align",
    "-Wconversion",
    "-Wsign-conversion",
    "-Wnull-dereference"
  ],
  "files.associations": {
    "iostream": "cpp",
    "array": "cpp",
    "type_traits": "cpp",
    "limits": "cpp"
  },
  "command-runner.commands": {
    "Build C++": "workbench.action.tasks.runTask Build Active C++ File",
    "Run .exe": "workbench.action.debug.start"
  },
  "statusbar.buttons": [
    {
      "text": "▶️ Build",
      "alignment": "left",
      "command": "command-runner.run",
      "args": "Build C++"
    },
    {
      "text": "🟢 Run",
      "alignment": "left",
      "command": "command-runner.run",
      "args": "Run .exe"
    }
  ]
}
